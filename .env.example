# Copier vers .env.local (jamais commité).
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique "anon" (ou nouvelle clé "publishable", même usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL publique de l'app (liens e-mail, liens de boutique). En prod : https://votre-domaine
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SasPay Configuration (Paiements d'abonnements en ligne - Mobile Money & Carte)
SASPAY_API_KEY=sk_test_...
SASPAY_WEBHOOK_SECRET=...

# Resend Configuration (Notifications e-mail de commande)
# Clé API obtenue sur resend.com
RESEND_API_KEY=re_...
# Optionnel : Expéditeur personnalisé (par défaut : onboarding@resend.dev)
# RESEND_FROM_EMAIL="Mon Commerce <commandes@mon-domaine.com>"

# ⚠️ AUCUNE clé service_role ici : l'application n'en a pas besoin.
# Les tests RLS utilisent un fichier séparé .env.test (voir .env.test.example).
